    {
      "id": "restricted",
      "config": {
        "models": {
          "mode": "merge",
          "providers": {
            "alpha": {
              "baseUrl": "https://alpha.acceptance.invalid/v1",
              "api": "openai-completions",
              "models": [
                { "id": "m1", "name": "Alpha One" },
                { "id": "m2", "name": "Alpha Two" }
              ]
            },
            "beta": {
              "baseUrl": "https://beta.acceptance.invalid/v1",
              "api": "openai-completions",
              "models": [
                { "id": "ns/one", "name": "Beta One" },
                { "id": "ns/two", "name": "Beta Two" }
              ]
            },
