              "models": [
                { "id": "m1", "name": "Alpha One" },
                { "id": "m2", "name": "Alpha Two" }
              ]
            }
          }
        },
        "agents": {
          "defaults": {
            "models": {
              "alpha/m1": { "alias": "legacy-alpha" },
              "alpha/metadata-only": { "alias": "metadata-only" }
            }
          }
        }
      },
      "disabledProviderIds": [],
      "expected": {
        "status": {
          "modelPolicyMode": "legacy",
          "allowlistModelCount": 2,
          "effectiveModelCount": 1
        },
        "models": {
          "alpha/m1": {
            "enabled": true,
            "selectionSource": "legacy",
            "alias": "legacy-alpha"
          },
          "alpha/m2": {
            "enabled": false
          },
          "alpha/metadata-only": {
            "enabled": true,
            "selectionSource": "legacy",
            "alias": "metadata-only"
          }
        },
        "providers": {
          "alpha": {
            "disabled": false,
            "enabledModelCount": 1
          }
        }
      }
    },
